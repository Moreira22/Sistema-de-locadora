<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">


    <changeSet id="1762884052231-1" author="basis">
        <createSequence incrementBy="1" sequenceName="seq_usuario" startValue="1"/>
        <createTable tableName="socio">
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_socio"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="usuario_id" baseTableName="socio" constraintName="FK_SOCIO_ON_USUARIO"
                                 referencedColumnNames="id" referencedTableName="usuario"/>
    </changeSet>
</databaseChangeLog>
