<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1758659458503-1" author="basis">
        <createSequence incrementBy="1" sequenceName="seq_titulo_ator" startValue="1"/>
        <createTable tableName="titulo_ator">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_titulo_ator"/>
            </column>
            <column name="titulo_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="ator_id" baseTableName="titulo_ator"
                                 constraintName="FK_TITULO_ATOR_ON_ATOR" referencedColumnNames="id"
                                 referencedTableName="ator"/>
        <addForeignKeyConstraint baseColumnNames="titulo_id" baseTableName="titulo_ator"
                                 constraintName="FK_TITULO_ATOR_ON_TITULO" referencedColumnNames="id"
                                 referencedTableName="titulo"/>
    </changeSet>
</databaseChangeLog>
