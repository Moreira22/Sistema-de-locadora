<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">


    <changeSet id="1758569280867-1" author="basis">
        <createSequence incrementBy="1" sequenceName="seq_endereco" startValue="1"/>
        <createTable tableName="endereco">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_endereco"/>
            </column>
            <column name="rua" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="numero" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="bairro" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="cep" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="cidade_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="cidade_id" baseTableName="endereco"
                                 constraintName="FK_ENDERECO_ON_CIDADE" referencedColumnNames="id"
                                 referencedTableName="cidade"/>
    </changeSet>
</databaseChangeLog>
