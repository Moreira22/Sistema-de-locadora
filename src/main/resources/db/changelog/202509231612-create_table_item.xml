<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">


    <changeSet id="1758657629024-1" author="basis">
        <createSequence incrementBy="1" sequenceName="seq_item" startValue="1"/>
        <createTable tableName="item">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_item"/>
            </column>
            <column name="numero_serie" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="data_aquisixao" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="titulo_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="numero_serie" constraintName="uc_item_numero_serie" tableName="item"/>
        <addForeignKeyConstraint baseColumnNames="titulo_id" baseTableName="item" constraintName="FK_ITEM_ON_TITULO"
                                 referencedColumnNames="id" referencedTableName="titulo"/>
    </changeSet>
</databaseChangeLog>
