<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1758656608396-1" author="basis">
        <createSequence incrementBy="1" sequenceName="seq_titulo" startValue="1"/>
        <createTable tableName="titulo">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_titulo"/>
            </column>
            <column name="ano" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="sinopse" type="oid">
                <constraints nullable="false"/>
            </column>
            <column name="imagem" type="BLOB">
                <constraints nullable="false"/>
            </column>
            <column name="classe_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="categoria_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="categoria_id" baseTableName="titulo"
                                 constraintName="FK_TITULO_ON_CATEGORIA" referencedColumnNames="id"
                                 referencedTableName="categoria"/>
        <addForeignKeyConstraint baseColumnNames="classe_id" baseTableName="titulo" constraintName="FK_TITULO_ON_CLASSE"
                                 referencedColumnNames="id" referencedTableName="classe"/>
    </changeSet>
</databaseChangeLog>
